# Base de données PostgreSQL 17 (dans Docker : hôte "postgres", port 5432)
POSTGRES_PASSWORD=change-me-postgres-password-in-production
DATABASE_URL=postgresql://mdl:change-me-postgres-password-in-production@postgres:5432/mdl
UPLOADS_DIR=./data/uploads

# Clés secrètes (Générer chaque clé avec : openssl rand -hex 32)
SESSION_SECRET=dev-session-secret-change-me-in-production-32bytes
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
JWT_TICKET_SECRET=dev-ticket-jwt-secret-change-me-in-production
TICKET_ED25519_PRIVATE_KEY_HEX=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# URL publique (ex: https://mdl.monlycee.fr via Cloudflare Tunnel)
PUBLIC_APP_URL=http://localhost:5173
PUBLIC_SCHOOL_NAME=Lycée Jean Moulin
PUBLIC_MDL_NAME=MDL Connect

# Web Push VAPID (généré automatiquement ou via npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:mdl@monlycee.fr

# Email SMTP optionnel (ex: Brevo gratuit 300 mails/jour)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=MDL Connect <mdl@monlycee.fr>

# Stripe optionnel (laisser vide pour mode 100% gratuit / espèces & virement)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Fournisseur textile optionnel (pré-remplit les bons de commande CSV / mailto de la boutique)
MERCH_SUPPLIER_NAME=
MERCH_SUPPLIER_EMAIL=
MERCH_SUPPLIER_URL=

# Impression à la demande automatique optionnelle : Gelato API v4 (0 EUR/mois, impression France/UE)
# Laisser vide pour fonctionner uniquement en précommandes manuelles / imprimeur local.
# GELATO_ORDER_TYPE=draft (brouillon à valider) ou order (envoi direct en impression)
GELATO_API_KEY=
GELATO_ORDER_TYPE=draft
GELATO_SHIP_COUNTRY=FR
GELATO_SHIP_FIRST_NAME=
GELATO_SHIP_LAST_NAME=
GELATO_SHIP_ADDRESS_LINE1=
GELATO_SHIP_POSTAL_CODE=
GELATO_SHIP_CITY=
GELATO_SHIP_EMAIL=
GELATO_SHIP_PHONE=

# Compte Président initial pour bootstrap
ADMIN_EMAIL=president@mdl.local
ADMIN_PASSWORD=MdlAdmin2026!ChangeMe

# ==============================================================================
# Déploiement Auto-Hébergé (Cloudflare Tunnel + Sauvegardes chiffrées R2)
# ==============================================================================

# Laisser vide en local. Mettre "tunnel" quand CLOUDFLARE_TUNNEL_TOKEN est renseigné
COMPOSE_PROFILES=
CLOUDFLARE_TUNNEL_TOKEN=

# Clé de chiffrement des sauvegardes (.tar.gz.enc) — si vide, utilise ENCRYPTION_KEY
BACKUP_ENCRYPTION_KEY=

# Nombre de jours/fichiers de sauvegarde locale à conserver
BACKUP_RETENTION_COUNT=14

# Stockage distant Cloudflare R2 optionnel (10 Go gratuits)
R2_BUCKET=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PREFIX=mdl-backups
